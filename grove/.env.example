# Rock server port exposed on the host
PORT=18085

# Rock administrator credentials
ROCK_ADMINISTRATOR_NAME=administrator
ROCK_ADMINISTRATOR_PASSWORD=change-this-admin-password

# Rock manager credentials
ROCK_MANAGER_NAME=manager
ROCK_MANAGER_PASSWORD=change-this-manager-password

# Rock user credentials
ROCK_USER_NAME=user
ROCK_USER_PASSWORD=change-this-user-password

# Rock server configuration
ROCK_ID=rock-grove-01
ROCK_CLUSTER=GROVE
ROCK_TAGS=grove,geospatial,tidyverse

